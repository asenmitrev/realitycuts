{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:unit": "vitest run",
    "build": "rm -rf ./dist_server/ && node build.js && cp .env.* dist_server/ && cp .vertex-key.json dist_server/",
    "build:lambda": "node build.js",
    "build:traditional": "rm -rf ./dist/ && yarn tsc --noEmit=false --outDir ./dist && cp -r images ./dist/ 2>/dev/null || true",
    "build:ec2": "rm -rf ./dist/ && node build-ec2.js",
    "start": "ENVIRONMENT=dev tsx watch index.ts",
    "tunnel:db": "aws ssm start-session --target $INSTANCE_ID  --document-name AWS-StartPortForwardingSession --parameters '{\"portNumber\":[\"27017\"],\"localPortNumber\":[\"27018\"]}'",
    "start:uat": "ENVIRONMENT=uat tsx watch index.ts",
    "typecheck": "tsc --noEmit",
    "test:render-html": "tsx scripts/test-render-html-to-video.ts"
  },
