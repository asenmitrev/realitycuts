# ============================================================
# VideoAI (RealityCuts) — Environment Variables
# ============================================================
# Copy this file to .env and fill in values.
# Server-specific files: app/server/.env.{dev,uat,test,prod}
# Client-specific files: app/client/.env
# ============================================================

# --- Application ---
ENVIRONMENT=local
PORT=3021
CLIENT_URL=http://localhost:3020
API_URL=http://localhost:3021

# --- Auth ---
JWT_SECRET=<generate-a-long-random-string>
JWT_REFRESH_SECRET=<generate-another-long-random-string>

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/videoai?authSource=admin&directConnection=true

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=videoai:

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=1703-media-app-2
MEDIA_BASE_URL=http://localhost:9000

# --- LLM / AI ---
OPENAI_KEY=<your-openai-key>
ANTHROPIC_API_KEY=<your-anthropic-key>
QWEN_KEY=<your-qwen-key>
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GROK_KEY=<your-grok-key>
PERPLEXITY_API_KEY=<your-perplexity-key>
PINECONE_KEY=<your-pinecone-key>
# Optional: OpenAI-compatible local LLM endpoint (e.g. LMStudio, Ollama)
LOCAL_LLM_BASE_URL=

# --- Media / Search ---
DEEPGRAM_API_KEY=<your-deepgram-key>
ELEVENLABS_API_KEY=<your-elevenlabs-key>
REPLICATE_API_TOKEN=<your-replicate-token>
PEXELS_API_KEY=<your-pexels-key>
TAVILY_API_KEY=<your-tavily-key>
YOUTUBE_API_KEY=<your-youtube-key>
# OAuth client for direct-to-YouTube upload (see README/CLAUDE.md "YouTube Upload").
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console, add
# http://localhost:3021/api/youtube/callback as an authorized redirect URI, and keep the
# consent screen in "Testing" mode with your own account as a test user — no Google review
# needed for a single self-hosted instance. Testing-mode refresh tokens expire after 7 days.
YOUTUBE_CLIENT_ID=<your-youtube-oauth-client-id>
YOUTUBE_CLIENT_SECRET=<your-youtube-oauth-client-secret>

# --- Monitoring (optional) ---
LOGGLY_TOKEN=<your-loggly-token>

# --- Rendering (local dev) ---
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional: override bundled ffmpeg/ffprobe binaries
FFMPEG_PATH=
FFPROBE_PATH=
